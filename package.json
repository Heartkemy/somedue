{
  "name": "somedue",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "bun test tests",
    "tauri": "tauri",
    "app": "bun scripts/macos-package.mjs",
    "package:macos": "SOMEDUE_CODESIGN_IDENTITY=- bun scripts/macos-package.mjs --all-targets --dmg",
    "cask:prepare": "bun scripts/homebrew-cask.mjs",
    "icon": "bun scripts/app-icon.mjs",
    "install:macos": "bun scripts/macos-package.mjs --install",
    "icons": "bun scripts/app-icon.mjs",
    "test:keychain": "bun scripts/keychain-test.mjs",
    "test:installed": "bun scripts/installed-keychain-test.mjs",
    "test:native": "bun scripts/native-test.mjs",
    "test:ui": "bun run build && playwright test",
    "test:ui:docker": "bun run build && bun scripts/ui-test-docker.mjs",
    "screenshots": "bun run build && bun scripts/ui-test-docker.mjs --config playwright.screenshots.config.ts",
    "notices": "bun scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@tauri-apps/api": "^2.9.0",
    "dompurify": "^3.4.17",
    "lucide-solid": "^0.468.0",
    "marked": "^18.1.1",
    "solid-js": "^1.9.9",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/bun": "latest",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
